<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hunter_relocalization</name>
  <version>1.0.0</version>
  <description>
    方案A 全局重定位节点（V0.0.93）。以 PCL NDT 将 FAST-LIO2 实时点云（odom 系）
    配准到先验全局点云地图（.pcd，map 系），估计并持续修正 map→odom TF，
    替代 AMCL（2D 粒子滤波对 3D 低矮结构/大范围地图不收敛）。是 map→odom→base_link
    TF 链中 map→odom 的唯一拥有者。
  </description>
  <maintainer email="developer@hunter.ai">HUNTER Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <depend>pcl_conversions</depend>

  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
