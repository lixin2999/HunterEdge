<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auto_mission</name>
  <version>1.0.0</version>
  <description>
    AUTO 模式自主任务调度节点。负责航点巡航任务管理、AUTO 进入条件守护、
    障碍物安全约束（减速/避让/急停），以及建图/定位模式切换支持。
  </description>
  <maintainer email="developer@hunter.ai">HUNTER Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- 核心 ROS2 依赖 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>

  <!-- Python 节点依赖 -->
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>rcl_interfaces</depend>

  <!-- 标准消息 -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Nav2 action/service 接口 -->
  <depend>nav2_msgs</depend>

  <!-- HUNTER 自定义消息 -->
  <depend>hunter_msgs</depend>

  <!-- TF2（用于坐标系判断） -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
