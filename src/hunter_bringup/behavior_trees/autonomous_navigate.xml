<?xml version="1.0"?>
<!--
  autonomous_navigate.xml — HUNTER 自主导航扩展行为树
  =====================================================================
  在原始 navigate_to_pose.xml 基础上新增：
    1. 定位有效性前置检查（TransformAvailable：map → base_link）
    2. 障碍物感知超时检查（TimeExpired 哨兵，感知数据停止后快速失效）
    3. （V0.0.82 移除 SpeedController：本 fork 该节点为按速度调 tick 周期的装饰器、
        无障碍物限速语义；动态减速由 RPP cost-regulation 机制承担）
    4. （V0.0.89 测试场地优化）路径受阻时【取消一切倒退/原地旋转恢复】——
       改为非运动恢复（清除代价地图 + 短暂 Wait 后重试），彻底杜绝
       "车辆只后退不前进"。窄小场地内 BackUp 会把车倒进更差的致命栅格，
       且倒车期间 AMCL 位姿反复跳变，实车验证弊大于利，故整体移除。
    5. GoalUpdated 响应：外部实时更新目标点时立即中断重规划

  BT 节点说明（全部来自 bt_navigator plugin_lib_names，无自定义插件）：
    TransformAvailable       — 检查指定坐标系变换是否可用（端口：child/parent）
    ComputePathToPose        — SmacPlannerHybrid 全局规划
    FollowPath               — RPP 局部跟踪控制（自带近障碍降速/近终点减速）
    GoalUpdated              — 外部目标点是否已更新（条件节点）
    Wait                     — 原地等待（非运动恢复，V0.0.89 起唯一恢复手段）
    ClearEntireCostmap       — 清除代价地图（全局/局部）
    RateController           — 限制子树执行频率
    RecoveryNode             — 带重试次数的恢复节点
    PipelineSequence         — 并发序列：前序节点失败不停止后续
    ReactiveFallback         — 响应式回退：持续检查条件
    RoundRobin               — 轮询执行恢复动作

  安全设计原则：
    • 定位不可用 → 立即中止整棵树，禁止发出任何速度指令
    • 感知数据超时（TimeExpired 2s）→ 触发 ClearLocalCostmap 并 Wait，
      等待感知恢复，防止代价地图信息过期后盲目通行
    • （V0.0.89）恢复行为不再包含任何倒退（BackUp）/原地旋转（Spin），
      窄小测试场地内仅清除代价地图 + 等待后重试，避免"只退不进"与定位跳变
  =====================================================================
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!--
      第 0 层：定位有效性前置门控
      map → base_link 变换不可用（FAST-LIO2 未收敛或 EKF 无输出）时，
      立即中止所有导航行为，等待定位恢复。
    -->
    <Sequence name="LocalizationGuard">

      <!-- 定位有效性检查：map → base_link TF 必须可用
           ⚠ 本 fork TransformAvailableCondition 端口名为 child/parent（见
           nav2_behavior_tree .../condition/transform_available_condition.hpp:65），
           写成 child_frame/parent_frame 会报 "Possible typo? ... port" 加载失败 -->
      <TransformAvailable
        name="CheckMapToBaseLink"
        child="base_link"
        parent="map"/>

      <!--
        第 1 层：外层恢复节点（最多重试 6 次）
        匹配原始行为树的恢复结构，失败后进入 RecoveryFallback
      -->
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">

        <!--
          主导航流水线：1Hz 重规划 + 路径跟踪
        -->
        <PipelineSequence name="NavigateWithReplanning">

          <!--
            感知数据保鲜检查：距上次代价地图更新超过 2s 则暂停规划，
            清除局部代价地图并等待感知数据恢复。
            使用 TimeExpired 作为哨兵（seconds=2.0s）。
            若感知恢复（TimeExpired 返回 FAILURE），流水线继续执行。
          -->
          <ReactiveFallback name="PerceptionFreshnessGuard">
            <!-- 感知数据新鲜时：TimeExpired 返回 FAILURE → 直接通过 -->
            <Inverter>
              <TimeExpired name="PerceptionStaleness" seconds="2.0"/>
            </Inverter>
            <!-- 感知数据超时：清除局部代价地图 + 短暂等待 -->
            <Sequence name="PerceptionRecovery">
              <ClearEntireCostmap
                name="ClearLocalCostmap-Perception"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </ReactiveFallback>

          <!--
            全局路径规划（V0.0.82：1Hz → 2Hz 重规划）
            实车教训：RPP 是纯路径跟随器、不具备局部避障语义，动态障碍
            完全依赖全局重规划绕行。1Hz × 高速 = 数米级反应盲区；
            2Hz + 降速 0.8m/s + safety_guard 碰撞闸三层兜底。
            失败时先尝试清除全局代价地图，再重规划一次
          -->
          <RateController hz="2.0">
            <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
              <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"/>
              <ClearEntireCostmap
                name="ClearGlobalCostmap-Context"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>

          <!--
            局部路径跟踪
            注（V0.0.82）：原 SpeedController 包装已移除——本 fork 的 SpeedController
            端口为 min_rate/max_rate/min_speed/max_speed（按平滑速度调整子树 tick 周期，
            见 speed_controller.hpp:56），并无 min_distance/max_distance/time_allowance
            端口（写了加载即报 "Possible typo? port"），也不具备"障碍物距离→限速"语义。
            障碍物动态减速由 RPP 自带机制覆盖：use_cost_regulated_linear_velocity_scaling
            （近障碍自动降速）+ approach_velocity_scaling（接近终点减速）。
          -->
          <RecoveryNode number_of_retries="1" name="FollowPathRecovery">

            <FollowPath path="{path}" controller_id="FollowPath"/>

            <!-- V0.0.89 跟踪失败恢复：仅清局部代价地图 + 短暂等待后重试，
                 不再 BackUp（阿克曼窄场地倒车会恶化定位、且与"向前巡航"相悖） -->
            <Sequence name="TrackingRecovery">
              <ClearEntireCostmap
                name="ClearLocalCostmap-Context"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>

          </RecoveryNode>

        </PipelineSequence>

        <!--
          恢复行为回退池（轮询）
          V0.0.89 测试场地：移除 Spin（阿克曼不能原地旋转）与 BackUp（倒车恶化
          定位/与向前巡航相悖），恢复退化为"清图 + 等待障碍让行"的非运动组合，
          多次清图仍规划失败则由外层 RecoveryNode 达上限后 ABORT 交 auto_mission 换点
        -->
        <ReactiveFallback name="RecoveryFallback">
          <!-- 外部目标点实时更新：立即重新规划 -->
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Subtree"
              service_name="global_costmap/clear_entirely_global_costmap"/>
            <ClearEntireCostmap
              name="ClearLocalCostmap-Subtree"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <!-- 等待：障碍物可能短暂通过，或等待人工把车移离致命栅格 -->
            <Wait wait_duration="3"/>
          </RoundRobin>
        </ReactiveFallback>

      </RecoveryNode>
      <!-- /NavigateRecovery -->

    </Sequence>
    <!-- /LocalizationGuard -->

  </BehaviorTree>
</root>
