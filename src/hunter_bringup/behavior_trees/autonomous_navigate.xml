<?xml version="1.0"?>
<!--
  autonomous_navigate.xml — HUNTER 自主导航扩展行为树
  =====================================================================
  在原始 navigate_to_pose.xml 基础上新增：
    1. 定位有效性前置检查（TransformAvailable：map → base_link）
    2. 障碍物感知超时检查（TimeExpired 哨兵，感知数据停止后快速失效）
    3. （V0.0.82 移除 SpeedController：本 fork 该节点为按速度调 tick 周期的装饰器、
        无障碍物限速语义；动态减速由 RPP cost-regulation 机制承担）
    4. （V0.0.89 测试场地优化，V0.0.95 修正）路径受阻时的恢复策略：
       V0.0.89 曾【取消一切倒退/原地旋转恢复】，只留“清图 + Wait”。实车证明
       该策略在“阿克曼 + 车头正对障碍”时永远无法脱困（V0.0.94 日志：车原地
       抖动 56s 零位移 → Fail to make progress 循环）。V0.0.95 起恢复**受限
       倒车脱困**（BackUp 0.30m @ 0.10m/s，位于 FollowPath 失败恢复序列），
       物理兜底：safety_guard 后方走廊判据（倒车时按 footprint_rear 判后净空）
       + 地图边界监护；原地旋转（Spin）仍保持移除（阿克曼不能原地转向）。
    5. GoalUpdated 响应：外部实时更新目标点时立即中断重规划

  BT 节点说明（全部来自 bt_navigator plugin_lib_names，无自定义插件）：
    TransformAvailable       — 检查指定坐标系变换是否可用（端口：child/parent）
    ComputePathToPose        — SmacPlannerHybrid 全局规划
    FollowPath               — MPPI 局部跟踪控制
    GoalUpdated              — 外部目标点是否已更新（条件节点）
    Wait                     — 原地等待（非运动恢复）
    BackUp                   — 受限倒车脱困（V0.0.95 恢复，仅 FollowPath 失败时）
    ClearEntireCostmap       — 清除代价地图（全局/局部）
    RateController           — 限制子树执行频率
    RecoveryNode             — 带重试次数的恢复节点
    PipelineSequence         — 并发序列：前序节点失败不停止后续
    ReactiveFallback         — 响应式回退：持续检查条件
    RoundRobin               — 轮询执行恢复动作

  安全设计原则：
    • 定位不可用 → 立即中止整棵树，禁止发出任何速度指令
    • 感知数据超时（TimeExpired 2s）→ 触发 ClearLocalCostmap 并 Wait，
      等待感知恢复，防止代价地图信息过期后盲目通行
    • （V0.0.95）恢复行为中的倒车为“受限倒车”：距离 ≤0.45m、速度 ≤0.10m/s，
      且由 safety_guard 后方走廊 + 地图边界双重兜底；不含原地旋转
  =====================================================================
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!--
      第 0 层：定位有效性前置门控
      map → base_link 变换不可用（FAST-LIO2 未收敛或 EKF 无输出）时，
      立即中止所有导航行为，等待定位恢复。
    -->
    <Sequence name="LocalizationGuard">

      <!-- 定位有效性检查：map → base_link TF 必须可用
           ⚠ 本 fork TransformAvailableCondition 端口名为 child/parent（见
           nav2_behavior_tree .../condition/transform_available_condition.hpp:65），
           写成 child_frame/parent_frame 会报 "Possible typo? ... port" 加载失败 -->
      <TransformAvailable
        name="CheckMapToBaseLink"
        child="base_link"
        parent="map"/>

      <!--
        第 1 层：外层恢复节点（最多重试 6 次）
        匹配原始行为树的恢复结构，失败后进入 RecoveryFallback
      -->
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">

        <!--
          主导航流水线：1Hz 重规划 + 路径跟踪
        -->
        <PipelineSequence name="NavigateWithReplanning">

          <!--
            感知数据保鲜检查：距上次代价地图更新超过 2s 则暂停规划，
            清除局部代价地图并等待感知数据恢复。
            使用 TimeExpired 作为哨兵（seconds=2.0s）。
            若感知恢复（TimeExpired 返回 FAILURE），流水线继续执行。
          -->
          <ReactiveFallback name="PerceptionFreshnessGuard">
            <!-- 感知数据新鲜时：TimeExpired 返回 FAILURE → 直接通过 -->
            <Inverter>
              <TimeExpired name="PerceptionStaleness" seconds="2.0"/>
            </Inverter>
            <!-- 感知数据超时：清除局部代价地图 + 短暂等待 -->
            <Sequence name="PerceptionRecovery">
              <ClearEntireCostmap
                name="ClearLocalCostmap-Perception"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </ReactiveFallback>

          <!--
            全局路径规划（V0.0.92：2Hz 降回 1Hz 重规划）
            实车教训：V0.0.82 将 1Hz 调高到 2Hz 是为了提高动态障碍响应，
            但实车验证发现：假障碍（代价地图未清）+ 2Hz 重规划 = 每 0.5s
            收到一次局部代价地图更新就重算路径，方向抖动导致 RPP 全幅振荡。
            1Hz + 清图门控（V0.0.92 clearCostmapsOnStart 同步等待）的组合
            效果更稳定，动态障碍避让由 safety_guard + RPP cost-regulation 覆盖。
            失败时先尝试清除全局代价地图，再重规划一次
          -->
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
              <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"/>
              <ClearEntireCostmap
                name="ClearGlobalCostmap-Context"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>

          <!--
            局部路径跟踪
            注（V0.0.82）：原 SpeedController 包装已移除——本 fork 的 SpeedController
            端口为 min_rate/max_rate/min_speed/max_speed（按平滑速度调整子树 tick 周期，
            见 speed_controller.hpp:56），并无 min_distance/max_distance/time_allowance
            端口（写了加载即报 "Possible typo? port"），也不具备"障碍物距离→限速"语义。
            障碍物动态减速由 RPP 自带机制覆盖：use_cost_regulated_linear_velocity_scaling
            （近障碍自动降速）+ approach_velocity_scaling（接近终点减速）。
          -->
          <RecoveryNode number_of_retries="1" name="FollowPathRecovery">

            <FollowPath path="{path}" controller_id="FollowPath"/>

            <!-- V0.0.89 跟踪失败恢复：先清局部代价地图，再做【受限倒车脱困】，最后
                 短暂等待后重试。V0.0.95 恢复 BackUp 的依据与安全边界：
                   ① 阿克曼车辆无法原地转向，"车头正对障碍 + 目标在障碍另一侧/自身附近"
                      时，纯非运动恢复（清图+Wait）永远无法脱困 —— 现场 V0.0.94 日志
                      即为此情形（车原地抖动 56s 无位移，随后 Fail to make progress 循环）；
                   ② V0.0.89 移除 BackUp 的顾虑是"倒进更差的致命栅格 + AMCL 位姿跳变"。
                      V0.0.93 起全局定位改为 NDT 点云重配准（不依赖倒车运动模型），
                      且 safety_guard 在指令为负时自动切换【后方走廊】判据
                      （footprint_rear+self_margin 起算，净空 < stop_dist 即零速），
                      外加 enable_map_fence 地图边界监护 → 倒车有双重物理兜底；
                   ③ 距离/速度取保守值（0.45m / 0.10m/s），且必须 > safety_guard 的
                      stop_release_hysteresis（0.25m）——否则"倒完仍不放行"，车辆
                      被滞环锁死原地；倒车后 1Hz 重规划会重新给出绕行路径
                      （Smac + costmap obstacle_layer 已标真实障碍）。
                 注：倒车速度能通过 velocity_smoother 的前提是 nav2_params.yaml 的
                 min_velocity[0] < 0（V0.0.95 由 0.0 → -0.20，见该文件注释）。 -->
            <Sequence name="TrackingRecovery">
              <ClearEntireCostmap
                name="ClearLocalCostmap-Context"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <BackUp backup_dist="0.45" backup_speed="0.10" time_allowance="10.0"/>
              <Wait wait_duration="1"/>
            </Sequence>

          </RecoveryNode>

        </PipelineSequence>

        <!--
          恢复行为回退池（轮询）
          V0.0.89 测试场地：移除 Spin（阿克曼不能原地旋转）。
          V0.0.95 恢复受限倒车（BackUp）于 FollowPath 失败恢复序列。
          V0.0.96 关键修正——把 BackUp 提到回退池【首位】：
            现场日志（V0.0.95 实车）显示真正的卡死来自【规划失败】而非跟踪失败——
            车开到航点附近后停在静态地图障碍的膨胀区内，SmacPlannerHybrid 的
            areInputsValid() 判起点无效，持续抛
            "Starting point in lethal space! Cannot create feasible plan."，
            此时恢复池若只有“清图 + Wait”则永远无法脱困：
              • 清图无效——StaticLayer::reset() 只置 has_updated_data_ 并由静态地图
                重新盖章（动态障碍标记会被清掉，静态障碍不会）；
              • 等待无效——起点有效性不随时间变化；
              • 唯一出路是【物理驶离膨胀区】→ 倒车 0.45m 后 1Hz 重规划即可成功。
            安全兜底同 FollowPath 恢复：safety_guard 倒车时按【后方走廊】判据
            （后净空 < stop_dist 即零速）+ 地图边界监护；BackUp 受限（0.45m/0.10m/s，
            time_allowance 6s），失败也只损失约 1 个恢复周期。
        -->
        <ReactiveFallback name="RecoveryFallback">
          <!-- 外部目标点实时更新：立即重新规划 -->
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <!-- V0.0.96：首位——让"停在膨胀/致命区内"的规划失败能物理脱困 -->
            <BackUp backup_dist="0.45" backup_speed="0.10" time_allowance="6.0"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Subtree"
              service_name="global_costmap/clear_entirely_global_costmap"/>
            <ClearEntireCostmap
              name="ClearLocalCostmap-Subtree"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <!-- 等待：障碍物可能短暂通过，或等待人工把车移离致命栅格 -->
            <Wait wait_duration="2"/>
          </RoundRobin>
        </ReactiveFallback>

      </RecoveryNode>
      <!-- /NavigateRecovery -->

    </Sequence>
    <!-- /LocalizationGuard -->

  </BehaviorTree>
</root>
