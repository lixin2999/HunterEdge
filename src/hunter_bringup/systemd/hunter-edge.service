[Unit]
Description=HunterEdge Autonomous Driving Stack (ready state; CAN + Kafka + Nav2/auto_mission)
Documentation=file:///etc/hunter/README_agent_env
# 上电时序（需求①→②）：先底盘 CAN 通信，再 HunterEdge 整栈。
# Requires=：CAN 未就绪则不启动本服务（“底盘都没通就别把车挂到 AUTO 待命状态”）；
# After= 保证 hunter-can 完成（Type=oneshot + RemainAfterExit）后才拉起本服务；
# network-online.target 保证 Kafka（运营端）接入前网络已就绪。
# V0.1.34：上电时钟闸门（见下方 ExecStartPre）——本机 RTC 掉电不保持时间，栈必须等 NTP
# 首同步后再起，否则时钟被拨 15h+ 会让全栈消息时间戳/TF 缓存失效（release.md V0.1.33 §8）。
Requires=hunter-can.service
After=hunter-can.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
# 自动驾驶准备状态（需求②）：自主导航待命；建图/联调可用 HUNTER_EDGE_* 覆盖
Environment=HUNTER_EDGE_AUTONOMOUS_NAV=true
Environment=HUNTER_EDGE_NAV_MODE=nav
EnvironmentFile=-/etc/hunter/agent_env.sh
# ExecStartPre ①（V0.1.34）：时钟闸门 —— 等 NTP 首同步，默认上限 60s；超时只告警、不阻断启动。
# 不能用 `After=time-sync.target` + systemd-time-wait-sync.service 的硬等写法：NTP 不可达时会
# 无限阻塞，等价于车永远不启动。实测事故：开机 19s 起栈，17s 后 NTP 把时钟前拨 55970s
# ⇒ MessageFilter 整帧丢弃、代价地图空、FAST-LIO2 发散 845km 后 SIGSEGV。
ExecStartPre=/bin/bash -c 'S="${HUNTER_CLOCK_GATE_SCRIPT:-}"; if [ -z "$S" ]; then for c in "${HUNTER_WS_PREFIX:-$HOME/HunterEdge/install}/share/hunter_bringup/scripts/hunter_clock_gate.sh" "${HUNTER_SRC_DIR:-$HOME/HunterEdge}/src/hunter_bringup/scripts/hunter_clock_gate.sh"; do [ -f "$c" ] && { S="$c"; break; }; done; fi; if [ -z "$S" ]; then echo "[hunter-edge] 未找到 hunter_clock_gate.sh，跳过时钟闸门" >&2; exit 0; fi; exec /bin/bash "$S"'
# ExecStartPre ②：CAN 幂等复查（接口真掉了直接失败 → Restart=on-failure 重新走一遍完整时序）
ExecStartPre=/bin/bash -c 'S="${HUNTER_CAN_UP_SCRIPT:-}"; if [ -z "$S" ]; then for c in "${HUNTER_WS_PREFIX:-$HOME/HunterEdge/install}/share/hunter_bringup/scripts/hunter_can_up.sh" "${HUNTER_SRC_DIR:-$HOME/HunterEdge}/src/hunter_bringup/scripts/hunter_can_up.sh"; do [ -f "$c" ] && { S="$c"; break; }; done; fi; exec /bin/bash "$S" --quick'
ExecStart=/bin/bash -c 'S="${HUNTER_EDGE_UP_SCRIPT:-}"; if [ -z "$S" ]; then for c in "${HUNTER_WS_PREFIX:-$HOME/HunterEdge/install}/share/hunter_bringup/scripts/hunter_edge_up.sh" "${HUNTER_SRC_DIR:-$HOME/HunterEdge}/src/hunter_bringup/scripts/hunter_edge_up.sh"; do [ -f "$c" ] && { S="$c"; break; }; done; fi; [ -f "$S" ] || { echo "[hunter-edge] 未找到 hunter_edge_up.sh（用 HUNTER_EDGE_UP_SCRIPT 指定绝对路径）" >&2; exit 1; }; exec /bin/bash "$S"'
# 整栈启动含相机硬件复位（initial_reset）与 Nav2 lifecycle，给足启动时间
# V0.1.34：180 → 240，为时钟闸门（最长 60s 等待 NTP 同步）预留余量
TimeoutStartSec=240
Restart=on-failure
RestartSec=10
# 退出宽限（V0.1.12 下调）：fast_lio2 建图模式写 PCD + data_agent flush 残留消息一般 < 30s；
# 旧值 120s 叠 KillMode=mixed 会先 SIGINT 主进程、等满后再 SIGKILL 到全组，残留一堆 root
# 属主的 /dev/shm/fastrtps_* 段与 sem.fastrtps_*，拖坑下一次开机。30s 够日常、够 PCD 写入。
TimeoutStopSec=60
KillSignal=SIGINT
# V0.1.12：mixed → control-group（SIGINT 同时下发到整组，launch 与子 ROS 节点一起走
# finally；避免旧模式下主进程先退、子进程等 SIGKILL 时 DDS Participant 来不及销毁）。
KillMode=control-group
# V0.1.12 新增：无论正常退出还是 SIGKILL 后，都主动清一下残留的 SHM 段/信号量，
# 避免 root 属主文件卡住 agilex 侧的 sem_open(O_RDWR)。CycloneDDS 默认不建 SHM，
# 属保险起见的兑底；兼容 FastDDS 回退时同样有效。
ExecStopPost=/bin/bash -c 'rm -f /dev/shm/fastrtps_* /dev/shm/sem.fastrtps_* /dev/shm/CycloneDDS.* /dev/shm/sem.CycloneDDS.* 2>/dev/null || true'
LimitNOFILE=65536
# V0.1.30 防复发加固③：提升自动驾驶整栈的 CPU 调度优先级，防 CPU 超订饿死 FAST-LIO2。
# 根因：调试期手工起的 rviz2（另一个 user/xrdp cgroup）抢走 ~3 核，本服务整栈被挤到
# CPU 不足 → FAST-LIO2 起步饥饿 → /Odometry 发散→ TF 断裂→重定位发散→MAP_EDGE_STOP 假锁死。
#   • Nice=-10：服务及其 fork 出的所有 ROS 子进程（继承 nice）相对普通用户进程优先获得 CPU；
#     对同 cgroup 内争抢有效（需特权，User=root 满足）。
#   • CPUWeight=200：本服务 cgroup 相对其它 cgroup（如 GUI/xrdp 会话）拿到 ~2x CPU 带宽份额，
#     解决跨 cgroup 争抢（Nice 无法跨 cgroup 生效时的补充）。默认 100，取 200 提权。
# 与 launch 侧 OMP_NUM_THREADS=4 配合：既不让 fast_lio2 贪心开满核互相踩踏，又保证它优先拿到核。
Nice=-10
CPUWeight=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
