[Unit]
Description=HUNTER Remote Control Agent (HunterCore Kafka: remote_control / event)
Documentation=file:///etc/hunter/README_agent_env
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
# 由 hunter_core_setup.sh 生成：HUNTER_WS_PREFIX 指向 colcon 安装目录
# （例：/home/hunter/hunter_ws/install），Agent 可执行文件在 <prefix>/lib/<pkg>/<pkg>
EnvironmentFile=-/etc/hunter/agent_env.sh
# 必须 source ROS2 与工作空间：remote_agent 依赖 hunter_msgs（ChassisCommand）与 hunter_kafka
# ⚠ 执行的是 **lib/<pkg>/<pkg>_node 普通脚本**（不依赖 setuptools 发行版元数据）。
#   直接用 console_scripts 入口（lib/<pkg>/<pkg>）在 --symlink-install 下会抛
#   `PackageNotFoundError: No package metadata was found for remote-agent`
#   （easy-install.pth 在 PYTHONPATH 下不生效）→ 服务陷入 activating 重启循环（实机踩中）。
ExecStart=/bin/bash -c 'P="${HUNTER_WS_PREFIX:-/home/hunter/hunter_ws/install}"; source "${HUNTER_ROS_SETUP:-/opt/ros/humble/setup.bash}" && source "$P/setup.bash" && exec "$P/lib/remote_agent/remote_agent_node" --config "${HUNTER_REMOTE_CONFIG:-/etc/hunter/remote_agent_params.yaml}"'
Restart=on-failure
RestartSec=5
# 资源限制
LimitNOFILE=65536
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
