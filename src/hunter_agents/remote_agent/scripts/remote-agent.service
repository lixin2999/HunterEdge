[Unit]
Description=HUNTER Remote Control Agent (HunterCore Kafka: remote_control / event)
Documentation=file:///etc/hunter/README_agent_env
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
# 由 hunter_core_setup.sh 生成：HUNTER_WS_PREFIX 指向 colcon 安装目录
# （例：/home/hunter/hunter_ws/install），Agent 可执行文件在 <prefix>/lib/<pkg>/<pkg>
EnvironmentFile=-/etc/hunter/agent_env.sh
# 必须 source ROS2 与工作空间：remote_agent 依赖 hunter_msgs（ChassisCommand）与 hunter_kafka
# ⚠ 可执行文件定位（V0.1.08 修复）：colcon 默认**隔离安装**，包前缀是 <安装根>/<pkg>，
#   即 <WS>/install/remote_agent/lib/remote_agent/remote_agent_node；
#   旧写法 <安装根>/lib/<pkg>/... 属 --merge-install 布局 → 实机必报
#   `127 .../install/lib/remote_agent/remote_agent_node: No such file or directory`。
#   这里按「隔离安装 → 合并安装 → 源码树」依次探测；全都找不到就打印候选路径后退出 1。
ExecStart=/bin/bash -c 'R="${HUNTER_WS_PREFIX:-$HOME/HunterEdge/install}"; S="${HUNTER_SRC_DIR:-$HOME/HunterEdge}"; source "${HUNTER_ROS_SETUP:-/opt/ros/humble/setup.bash}" >/dev/null 2>&1 || true; source "$R/setup.bash" >/dev/null 2>&1 || true; for c in "$R/remote_agent/lib/remote_agent/remote_agent_node" "$R/lib/remote_agent/remote_agent_node" "$S/src/hunter_agents/remote_agent/scripts/remote_agent_node"; do if [ -f "$c" ]; then exec "$c" --config "${HUNTER_REMOTE_CONFIG:-/etc/hunter/remote_agent_params.yaml}"; fi; done; echo "[remote-agent] 未找到 remote_agent_node（三个候选路径都不存在）：$R/remote_agent/lib/remote_agent/remote_agent_node | $R/lib/remote_agent/remote_agent_node | $S/src/hunter_agents/remote_agent/scripts/remote_agent_node；处置：colcon build --symlink-install --packages-select remote_agent，并核对 /etc/hunter/agent_env.sh 的 HUNTER_WS_PREFIX/HUNTER_SRC_DIR" >&2; exit 1'
Restart=on-failure
RestartSec=5
# ⚠ 停止语义（V0.1.10，实机证据 `Failed with result 'timeout'` + 一串 SIGKILL）：
#   默认 SIGTERM 会让 Python **直接终止、不走 finally** → GStreamer 子进程残留 →
#   systemd 等满 TimeoutStopSec 再把整个 cgroup 强杀，表现为"重启要等 90s / 结果 timeout"。
#   改 SIGINT：Python 抛 KeyboardInterrupt → run() 的 finally 执行 stop_gstreamer()/shutdown()
#   收拾干净再退出；KillMode=mixed 保证只有主进程收 SIGINT，超时才连带子进程强杀。
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
# 资源限制
LimitNOFILE=65536
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
