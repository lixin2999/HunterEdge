[Unit]
Description=HUNTER Remote Control Agent (HunterCore Kafka: remote_control / event)
Documentation=file:///etc/hunter/README_agent_env
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
# 由 hunter_core_setup.sh 生成：HUNTER_WS_PREFIX 指向 colcon 安装目录
# （例：/home/hunter/hunter_ws/install），Agent 可执行文件在 <prefix>/lib/<pkg>/<pkg>
EnvironmentFile=-/etc/hunter/agent_env.sh
# 必须 source ROS2 与工作空间：remote_agent 依赖 hunter_msgs（ChassisCommand）与 hunter_kafka
ExecStart=/bin/bash -c 'P="${HUNTER_WS_PREFIX:-/home/hunter/hunter_ws/install}"; source "${HUNTER_ROS_SETUP:-/opt/ros/humble/setup.bash}" && source "$P/setup.bash" && exec "$P/lib/remote_agent/remote_agent" --config "${HUNTER_REMOTE_CONFIG:-/etc/hunter/remote_agent_params.yaml}"'
Restart=on-failure
RestartSec=5
# 资源限制
LimitNOFILE=65536
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
