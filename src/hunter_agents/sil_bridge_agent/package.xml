<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sil_bridge_agent</name>
  <version>1.0.0</version>
  <description>SIL bridge agent for HUNTER autonomous vehicle system - injects CARLA simulation sensors into HunterEdge ROS topics and returns /cmd_vel to the simulator over Kafka</description>
  <maintainer email="developer@hunter.ai">HUNTER Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>hunter_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>hunter_kafka</depend>
  <depend>python3-numpy</depend>
  <depend>opencv-python</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>