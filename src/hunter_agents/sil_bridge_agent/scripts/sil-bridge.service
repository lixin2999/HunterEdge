[Unit]
Description=HUNTER SIL Bridge Agent (CARLA <-> HunterEdge full-stack SIL loop via Kafka)
Documentation=file:///etc/hunter/README_agent_env
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
# 由 hunter_core_setup.sh 生成：HUNTER_WS_PREFIX 指向 colcon 安装目录
EnvironmentFile=-/etc/hunter/agent_env.sh
# ⚠ 仅 SIL 联调时启用本单元；实车模式必须 stop/disable（真实传感器驱动与 CAN 底盘
#   会被本 Agent 的同名话题抢占，形成双发布者）。
# ⚠ 可执行文件定位（沿用 remote-agent V0.1.08 修复）：colcon 默认**隔离安装**，
#   包前缀是 <安装根>/<pkg>；按「隔离安装 → 合并安装 → 源码树」依次探测。
# ⚠ 必须导出 RMW_IMPLEMENTATION（remote-agent V0.1.19 教训）：否则本 Agent 用默认
#   FastDDS 而 hunter-edge 用 CycloneDDS，/lidar_points、/cmd_vel 跨服务不可见。
ExecStart=/bin/bash -c 'R="${HUNTER_WS_PREFIX:-$HOME/HunterEdge/install}"; S="${HUNTER_SRC_DIR:-$HOME/HunterEdge}"; source "${HUNTER_ROS_SETUP:-/opt/ros/humble/setup.bash}" >/dev/null 2>&1 || true; source "$R/setup.bash" >/dev/null 2>&1 || true; export RMW_IMPLEMENTATION="${HUNTER_RMW_IMPLEMENTATION:-}"; for c in "$R/sil_bridge_agent/lib/sil_bridge_agent/sil_bridge_node" "$R/lib/sil_bridge_agent/sil_bridge_node" "$S/src/hunter_agents/sil_bridge_agent/scripts/sil_bridge_node"; do if [ -f "$c" ]; then exec "$c" --config "${HUNTER_SIL_CONFIG:-/etc/hunter/sil_bridge_params.yaml}"; fi; done; echo "[sil-bridge] 未找到 sil_bridge_node（三个候选路径都不存在）：$R/sil_bridge_agent/lib/sil_bridge_agent/sil_bridge_node | $R/lib/sil_bridge_agent/sil_bridge_node | $S/src/hunter_agents/sil_bridge_agent/scripts/sil_bridge_node；处置：colcon build --symlink-install --packages-select sil_bridge_agent，并核对 /etc/hunter/agent_env.sh 的 HUNTER_WS_PREFIX/HUNTER_SRC_DIR" >&2; exit 1'
Restart=on-failure
RestartSec=5
# ⚠ 停止语义（沿用 remote-agent V0.1.10 实机证据）：SIGTERM 会让 Python 直接终止、
#   不走 finally → 会话 stop 帧的**零速补帧**丢失 → 仿真自车保持末速度继续跑。
#   SIGINT 抛 KeyboardInterrupt → shutdown() 补零速 + producer flush + consumer close。
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
