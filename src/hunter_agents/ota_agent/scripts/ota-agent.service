[Unit]
Description=HUNTER OTA Upgrade Agent (non-ROS systemd service)
Documentation=docs/hunter/ota.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
# 主程序路径（部署到车辆后）
ExecStart=/usr/bin/python3 /opt/hunter/ota_agent/ota_agent.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 资源限制
LimitNOFILE=65536
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
